# Ollama connection (defaults work when Ollama runs on this same machine)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct

# Remote GPU on another home PC (CPU-only laptop → point at GPU machine):
# OLLAMA_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=qwen3-vl:2b-instruct

# Cloud GPU via RunPod HTTPS proxy (stop the pod when done to save money):
# OLLAMA_URL=https://xxxxxxxx-11434.proxy.runpod.net
# OLLAMA_MODEL=qwen3-vl:2b-instruct

# Cloud GPU via SSH tunnel (run: ssh -L 11434:127.0.0.1:11434 root@CLOUD_IP -N)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:2b-instruct

# Optional speed settings
# OLLAMA_FAST_MODE=true
# OLLAMA_KEEP_ALIVE=30m
